/* =====================================================
   DIARIO NARRATIVO - ESTILOS UI TOOLKIT
   ===================================================== */

/* Panel Principal del Diario - Pantalla Completa */
.diary-panel {
    position: absolute;
    width: 100%;
    height: 100%;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    padding: 0;
    margin: 0;
    display: none; /* Oculto por defecto - Cambiar a 'flex' temporalmente para ver en Preview */
    flex-direction: column;
    flex-grow: 1;
}

/* Botón Cerrar - Esquina Superior Derecha */
.close-button {
    position: absolute;
    top: 20px;
    right: 20px;
    width: 50px;
    height: 50px;
    margin: 0;
    padding: 0;
    /* Asegurar que esté por encima del contenido */
    z-index: 1000;
    cursor: link;
}

.close-button:hover {
    opacity: 0.8;
}

.close-button:active {
    opacity: 0.6;
}

/* Background del botón (sprite de cuadrado) */
.close-button-bg {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(150, 50, 50, 0.9);
    border-width: 2px;
    border-color: rgb(200, 100, 100);
    border-radius: 8px;
    /* Aquí puedes agregar tu sprite:
       background-image: url('project://database/path/to/your/square-sprite.png');
       -unity-background-scale-mode: scale-to-fit;
    */
}

/* Icono del botón (sprite de X) */
.close-button-icon {
    position: absolute;
    width: 70%;
    height: 70%;
    left: 15%;
    top: 15%;
    background-color: transparent;
    /* Aquí puedes agregar tu sprite de X:
       background-image: url('project://database/path/to/your/x-icon.png');
       -unity-background-scale-mode: scale-to-fit;
    */
    /* Por ahora, simulamos una X con color */
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

/* Contenido Principal Centrado */
.diary-content {
    flex-direction: column;
    flex-grow: 1;
    width: 100%;
    height: 100%;
    padding: 20px;
    align-items: center;
    justify-content: center;
}

/* ===== PANEL DE ENTRADA CENTRADO - Pantalla Completa ===== */
.entry-display-panel {
    width: 80%;
    max-width: 900px;
    height: 70%;
    max-height: 700px;
    background-color: rgba(40, 38, 35, 0.95);
    border-width: 4px;
    border-color: rgb(200, 180, 140);
    border-radius: 15px;
    padding: 40px;
    margin-bottom: 20px;
}

.entry-title {
    font-size: 32px;
    color: rgb(230, 210, 170);
    -unity-font-style: bold;
    margin-bottom: 20px;
    -unity-text-align: upper-center;
}

.entry-text-scrollview {
    flex-grow: 1;
    border-width: 2px;
    border-color: rgb(200, 180, 140);
    border-radius: 5px;
    padding: 15px;
}

.entry-text {
    font-size: 20px;
    color: rgb(210, 200, 180);
    white-space: normal;
    -unity-text-align: upper-left;
    padding: 10px;
}

/* ===== NAVEGACIÓN DE PÁGINAS ===== */
.navigation-panel {
    flex-direction: row;
    justify-content: space-between;
    width: 80%;
    max-width: 900px;
    padding: 0 40px;
}

.nav-button {
    width: 180px;
    height: 50px;
    font-size: 18px;
    color: rgb(220, 220, 230);
    background-color: rgba(60, 60, 70, 0.9);
    border-width: 3px;
    border-color: rgb(150, 140, 120);
    border-radius: 10px;
    padding: 10px;
}

.nav-button:hover {
    background-color: rgba(80, 80, 90, 1);
    border-color: rgb(200, 180, 140);
}

.nav-button:active {
    background-color: rgba(100, 100, 110, 1);
}

.nav-button:disabled {
    opacity: 0.4;
    background-color: rgba(40, 40, 50, 0.6);
}

/* Indicador de Página */
.page-indicator {
    font-size: 18px;
    color: rgb(180, 170, 150);
    -unity-text-align: middle-center;
    margin-top: 15px;
    -unity-font-style: italic;
}
