.diary-panel {
    position: absolute;
    width: 100%;
    height: 100%;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    padding: 0;
    margin: 0;
    display: none;
    flex-direction: column;
    flex-grow: 1;
}

.close-button {
    position: absolute;
    top: 20px;
    right: 20px;
    width: 100px;
    height: 100px;
    margin: 0;
    padding: 0;
    z-index: 1000;
    cursor: link;
}

.close-button:hover {
    opacity: 0.8;
}

.close-button:active {
    opacity: 0.6;
}

.close-button-bg {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(150, 50, 50, 0.9);
    border-width: 2px;
    border-color: rgb(200, 100, 100);
    border-radius: 8px;
}

.close-button-icon {
    position: absolute;
    width: 70%;
    height: 70%;
    left: 15%;
    top: 15%;
    background-color: transparent;
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.diary-content {
    flex-direction: column;
    flex-grow: 1;
    width: 100%;
    height: 100%;
    padding: 20px;
    align-items: center;
    justify-content: center;
}

.entry-display-panel {
    width: 80%;
    max-width: 900px;
    height: 70%;
    max-height: 700px;
    background-color: rgba(40, 38, 35, 0.95);
    border-width: 4px;
    border-color: rgb(200, 180, 140);
    border-radius: 15px;
    padding: 40px;
    margin-bottom: 20px;
}

.entry-title {
    font-size: 32px;
    color: rgb(230, 210, 170);
    -unity-font-style: bold;
    margin-bottom: 20px;
    -unity-text-align: upper-center;
}

.entry-text-scrollview {
    flex-grow: 1;
    border-width: 2px;
    border-color: rgb(200, 180, 140);
    border-radius: 5px;
    padding: 15px;
}

.entry-text {
    font-size: 20px;
    color: rgb(210, 200, 180);
    white-space: normal;
    -unity-text-align: upper-left;
    padding: 10px;
}

.navigation-panel {
    flex-direction: row;
    justify-content: space-between;
    width: 80%;
    max-width: 900px;
    padding: 0 40px;
}

.nav-button {
    width: 180px;
    height: 50px;
    font-size: 18px;
    color: rgb(255, 255, 255);
    background-color: rgb(59, 26, 13);
    border-width: 3px;
    border-color: rgb(150, 140, 120);
    border-radius: 10px;
    padding: 10px;
    -unity-text-align: upper-center;
    -unity-background-scale-mode: scale-and-crop;
}

.nav-button:hover {
    background-color: rgb(180, 120, 40);
    border-color: rgb(230, 200, 120);
    color: rgb(255, 255, 255);
    scale: 1.05;
}

.nav-button:active {
    background-color: rgb(30, 15, 5);
    border-color: rgb(100, 80, 50);
    scale: 0.95;
}

.nav-button:disabled {
    background-color: rgb(80, 75, 70);
    border-color: rgb(100, 95, 90);
    color: rgb(130, 125, 120);
    opacity: 1;
}

.page-indicator {
    font-size: 18px;
    color: rgb(180, 170, 150);
    -unity-text-align: middle-center;
    margin-top: 15px;
    -unity-font-style: italic;
}
