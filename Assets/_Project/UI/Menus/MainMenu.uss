.main-menu-overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.85);
    align-items: center;
    justify-content: center;
}

.main-menu-panel {
    width: 500px;
    padding: 40px;
    align-items: center;
    border-radius: 15px;
    -unity-background-scale-mode: scale-to-fit;
    margin-top: 100px;
}

.main-menu-title {
    font-size: 80px;
    color: rgb(35, 75, 90);
    -unity-font-style: normal;
    margin-bottom: 20px;
    -unity-text-align: middle-center;
    margin-top: 40px;
    -unity-font-definition: url("project://database/Assets/_Project/Fonts/BoldPixels.ttf?fileID=12800000&guid=89ae0ccf11ce0314bb60394e36bc1305&type=3#BoldPixels");
    letter-spacing: 3px;
}

.main-menu-welcome {
    font-size: 28px;
    color: rgb(60, 55, 50);
    margin-bottom: 30px;
    -unity-text-align: middle-center;
    -unity-font-definition: url("project://database/Assets/_Project/Fonts/BoldPixels.ttf?fileID=12800000&guid=89ae0ccf11ce0314bb60394e36bc1305&type=3#BoldPixels");
    margin-top: 70px;
}

.main-menu-button {
    width: 350px;
    height: 70px;
    font-size: 36px;
    color: rgb(255, 255, 255);
    background-color: rgb(35, 75, 90);
    border-width: 3px;
    border-color: rgb(127, 179, 192);
    border-radius: 10px;
    margin-bottom: 15px;
    -unity-text-align: middle-center;
    letter-spacing: 2px;
    -unity-font-definition: url("project://database/Assets/_Project/Fonts/BoldPixels.ttf?fileID=12800000&guid=89ae0ccf11ce0314bb60394e36bc1305&type=3#BoldPixels");
}

.main-menu-button:hover {
    background-color: rgb(232, 214, 107);
    border-color: rgb(255, 240, 150);
    color: rgb(30, 30, 30);
    scale: 1.05;
}

.main-menu-button:active {
    background-color: rgb(40, 70, 80);
    scale: 0.95;
}

.main-menu-button-secondary {
    width: 350px;
    height: 70px;
    font-size: 36px;
    color: rgb(80, 75, 70);
    background-color: rgba(0, 0, 0, 0.1);
    border-width: 3px;
    border-color: rgb(150, 145, 140);
    border-radius: 10px;
    margin-bottom: 15px;
    -unity-text-align: middle-center;
    letter-spacing: 2px;
    -unity-font-definition: url("project://database/Assets/_Project/Fonts/BoldPixels.ttf?fileID=12800000&guid=89ae0ccf11ce0314bb60394e36bc1305&type=3#BoldPixels");
}

.main-menu-button-secondary:hover {
    background-color: rgba(200, 60, 60, 0.2);
    border-color: rgb(200, 60, 60);
    color: rgb(180, 50, 50);
    scale: 1.05;
}

.main-menu-button-secondary:active {
    background-color: rgba(150, 40, 40, 0.3);
    scale: 0.95;
}

.button-container {
    align-items: center;
    margin-top: 20px;
}
