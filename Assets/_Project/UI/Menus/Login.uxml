<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/_Project/UI/Menus/Login.uss?fileID=7433441132597879392&amp;guid=aa648517a0de50142ac1a5f6d80a3c47&amp;type=3#Login" />
    <ui:VisualElement name="LoginOverlay" class="login-overlay" style="display: flex; top: 0; left: 0;">
        <ui:VisualElement name="LoginPanel" class="login-panel" style="background-image: url(&quot;project://database/Assets/_Project/Sprites/UI/Common/Backgrounds/bg_pause.png?fileID=2800000&amp;guid=e2463e23cff697647ae58e92412aaaab&amp;type=3#bg_pause&quot;); height: 621px; -unity-background-scale-mode: scale-and-crop; width: 607px;">
            <ui:Label text="INICIAR SESIÓN" name="LoginTitle" class="login-title" style="margin-top: 60px; width: 90%; margin-bottom: 30px; white-space: normal; -unity-font-style: normal;" />
            <ui:VisualElement name="UserSection" class="login-section">
                <ui:Label text="Usuario" name="UserLabel" class="login-label" />
                <ui:TextField name="UserInput" max-length="20" class="login-input" />
            </ui:VisualElement>
            <ui:Button text="Entrar" name="LoginButton" class="login-button" style="background-color: rgb(18, 73, 91); margin-top: 20px;" />
            <ui:Label name="ErrorLabel" class="error-label" style="display: none;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
