.pause-overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.7);
    align-items: center;
    justify-content: center;
}

.pause-panel {
    width: 400px;
    padding: 40px;
    align-items: center;
    border-radius: 15px;
    -unity-background-scale-mode: scale-to-fit;
    /* Asigna bg_pause.png desde UI Builder */
}

.pause-title {
    font-size: 48px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    margin-bottom: 40px;
    -unity-text-align: middle-center;
}

.pause-button {
    width: 280px;
    height: 50px;
    font-size: 22px;
    color: rgb(255, 255, 255);
    background-color: rgb(59, 26, 13);
    border-width: 3px;
    border-color: rgb(150, 140, 120);
    border-radius: 10px;
    margin-bottom: 15px;
    -unity-text-align: middle-center;
}

.pause-button:hover {
    background-color: rgb(180, 120, 40);
    border-color: rgb(230, 200, 120);
    scale: 1.05;
}

.pause-button:active {
    background-color: rgb(30, 15, 5);
    scale: 0.95;
}
