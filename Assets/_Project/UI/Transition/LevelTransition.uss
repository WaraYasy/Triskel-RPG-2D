#root {
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
}

#background {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgb(0, 0, 0);
}

#transition-text {
    font-size: 70px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    white-space: normal;
    max-width: 80%;
    padding: 50px;
    -unity-font-definition: url("project://database/Assets/_Project/Fonts/BoldPixels.ttf?fileID=12800000&guid=89ae0ccf11ce0314bb60394e36bc1305&type=3#BoldPixels");
}
