.transition-root {
    width: 100%;
    height: 100%;
    flex-direction: column;
    justify-content: space-between;
    align-items: center;
}

.transition-background {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgb(0, 0, 0);
}

.header-container {
    width: 100%;
    padding-top: 60px;
    padding-bottom: 20px;
    align-items: center;
    justify-content: center;
}

.transition-title {
    font-size: 100px;
    color: rgb(232, 214, 107);
    -unity-text-align: upper-center;
    -unity-font-style: normal;
    -unity-font-definition: url("project://database/Assets/_Project/Fonts/BoldPixels.ttf?fileID=12800000&guid=89ae0ccf11ce0314bb60394e36bc1305&type=3#BoldPixels");
    text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.8);
}

.content-container {
    flex-grow: 1;
    width: 100%;
    align-items: center;
    justify-content: center;
    padding-left: 50px;
    padding-right: 50px;
}

.transition-text {
    font-size: 50px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    white-space: normal;
    max-width: 80%;
    padding: 30px;
    -unity-font-definition: url("project://database/Assets/_Project/Fonts/BoldPixels.ttf?fileID=12800000&guid=89ae0ccf11ce0314bb60394e36bc1305&type=3#BoldPixels");
}

.footer-container {
    width: 100%;
    padding-bottom: 40px;
    padding-top: 20px;
    align-items: center;
    justify-content: center;
}

.diary-hint {
    font-size: 28px;
    color: rgba(200, 200, 200, 0.7);
    -unity-text-align: middle-center;
    -unity-font-style: italic;
    -unity-font-definition: url("project://database/Assets/_Project/Fonts/BoldPixels.ttf?fileID=12800000&guid=89ae0ccf11ce0314bb60394e36bc1305&type=3#BoldPixels");
}

#root {
    width: 100%;
    height: 100%;
    flex-direction: column;
    justify-content: space-between;
    align-items: center;
}

#background {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgb(0, 0, 0);
}

#transition-text {
    font-size: 50px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    white-space: normal;
    max-width: 80%;
    padding: 30px;
    -unity-font-definition: url("project://database/Assets/_Project/Fonts/BoldPixels.ttf?fileID=12800000&guid=89ae0ccf11ce0314bb60394e36bc1305&type=3#BoldPixels");
}
