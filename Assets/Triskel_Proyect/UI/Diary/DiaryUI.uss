.diary-panel {
    position: absolute;
    width: 100%;
    height: 100%;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    padding: 0;
    margin: 0;
    display: none;
    flex-direction: column;
    flex-grow: 1;
}

.close-button {
    position: absolute;
    top: 20px;
    right: 20px;
    width: 160px;
    height: 160px;
    margin: 0;
    padding: 0;
    cursor: link;
    -unity-background-scale-mode: stretch-to-fill;
    left: 60px;
}

.close-button:hover {
    opacity: 0.8;
}

.close-button:active {
    opacity: 0.6;
}

.close-button-bg {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(150, 50, 50, 0.9);
    border-width: 2px;
    border-color: rgb(200, 100, 100);
    border-radius: 8px;
}

.close-button-icon {
    position: absolute;
    width: 70%;
    height: 70%;
    left: 15%;
    top: 15%;
    background-color: transparent;
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.diary-content {
    flex-direction: column;
    flex-grow: 1;
    width: 100%;
    height: 100%;
    padding: 20px;
    align-items: center;
    justify-content: center;
}

.entry-display-panel {
    width: 80%;
    max-width: 900px;
    height: 70%;
    max-height: 700px;
    background-color: rgba(40, 38, 35, 0.95);
    border-width: 4px;
    border-color: rgb(200, 180, 140);
    border-radius: 15px;
    padding: 40px;
    margin-bottom: 20px;
}

.entry-title {
    font-size: 32px;
    color: rgb(230, 210, 170);
    -unity-font-style: bold;
    margin-bottom: 20px;
    -unity-text-align: upper-center;
}

.entry-text-scrollview {
    flex-grow: 1;
    border-width: 2px;
    border-color: rgb(200, 180, 140);
    border-radius: 5px;
    padding: 15px;
    overflow: hidden;
}

.entry-text {
    font-size: 35px;
    color: rgb(210, 200, 180);
    white-space: normal;
    -unity-text-align: upper-left;
    padding: 10px;
    width: 100%;
    flex-shrink: 1;
}

.navigation-panel {
    flex-direction: row;
    justify-content: space-between;
    width: 80%;
    max-width: 900px;
    padding: 0 40px;
}

.nav-button {
    width: auto;
    height: auto;
    font-size: 40px;
    color: rgb(255, 255, 255);
    background-color: rgb(35, 75, 90);
    border-width: 3px;
    border-color: rgb(127, 179, 192);
    border-radius: 10px;
    padding: 10px;
    -unity-text-align: upper-center;
    -unity-background-scale-mode: scale-and-crop;
    -unity-font-definition: url("project://database/Assets/Triskel_Proyect/Fonts/BoldPixels.ttf?fileID=12800000&guid=89ae0ccf11ce0314bb60394e36bc1305&type=3#BoldPixels");
    padding-left: 15px;
    padding-right: 15px;
    -unity-font-style: normal;
}

.nav-button:hover {
    background-color: rgb(232, 214, 107);
    border-color: rgb(255, 240, 150);
    color: rgb(30, 30, 30);
    scale: 1.05;
}

.nav-button:active {
    background-color: rgb(40, 70, 80);
    scale: 0.95;
}

.nav-button:disabled {
    background-color: rgb(80, 75, 70);
    border-color: rgb(100, 95, 90);
    color: rgb(130, 125, 120);
    opacity: 1;
}

.page-indicator {
    font-size: 18px;
    color: rgb(180, 170, 150);
    -unity-text-align: middle-center;
    margin-top: 15px;
    -unity-font-style: italic;
}

/* ====================================== */
/* SCROLLBAR STYLING - OCULTAR TODAS LAS BARRAS */
/* ====================================== */

/* Ocultar todas las barras de desplazamiento */
.entry-text-scrollview .unity-scroller--horizontal {
    display: none;
}

.entry-text-scrollview .unity-scroller--vertical {
    display: none;
}

/* ====================================== */
/* SCROLL INDICATOR - FLECHA */
/* ====================================== */

.scroll-indicator {
    position: absolute;
    bottom: 10px;
    right: 10px;
    width: 40px;
    height: 40px;
    background-color: rgba(200, 180, 140, 0.8);
    border-width: 2px;
    border-color: rgb(230, 210, 170);
    border-radius: 20px;
    align-items: center;
    justify-content: center;
    display: none;
}

.scroll-indicator-arrow {
    font-size: 30px;
    color: rgb(50, 40, 30);
    -unity-text-align: middle-center;
    -unity-font-style: bold;
}

.scroll-indicator:hover {
    background-color: rgba(232, 214, 107, 0.9);
    scale: 1.1;
}

.scroll-indicator:active {
    background-color: rgba(255, 230, 150, 0.9);
    scale: 0.95;
}
