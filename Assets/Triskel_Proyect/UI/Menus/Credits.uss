.credits-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    flex-grow: 1;
}

.credits-panel {
    width: 700px;
    height: 80%;
    padding: 40px;
    align-items: center;
    background-color: rgba(0, 0, 0, 0);
    margin-top: 10px;
}

.credits-title {
    font-size: 70px;
    color: rgb(35, 75, 90);
    -unity-font-style: normal;
    margin-bottom: 20px;
    -unity-text-align: middle-center;
    margin-top: 20px;
    letter-spacing: 3px;
}

.credits-scrollview {
    width: 100%;
    flex-grow: 1;
    margin-top: 10px;
    margin-bottom: 10px;
}

.credits-container {
    width: 100%;
    align-items: center;
    padding: 20px;
    font-size: 20px;
    -unity-font-definition: url("project://database/Assets/_Project/Fonts/BoldPixels.ttf?fileID=12800000&guid=89ae0ccf11ce0314bb60394e36bc1305&type=3#BoldPixels");
}

.credits-section-title {
    font-size: 45px;
    color: rgb(8, 74, 107);
    -unity-text-align: upper-center;
    margin-top: 30px;
    margin-bottom: 15px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    -unity-font-definition: url("project://database/Assets/_Project/Fonts/BoldPixels.ttf?fileID=12800000&guid=89ae0ccf11ce0314bb60394e36bc1305&type=3#BoldPixels");
}

.credits-entry {
    font-size: 30px;
    color: rgb(60, 55, 50);
    -unity-text-align: upper-center;
    margin-top: 5px;
    margin-bottom: 5px;
    -unity-font-definition: url("project://database/Assets/_Project/Fonts/BoldPixels.ttf?fileID=12800000&guid=89ae0ccf11ce0314bb60394e36bc1305&type=3#BoldPixels");
}

.credits-spacer {
    height: 40px;
}

.credits-footer {
    font-size: 45px;
    color: rgb(232, 214, 107);
    -unity-text-align: upper-center;
    margin-top: 10px;
    margin-bottom: 10px;
    letter-spacing: 2px;
}

.credits-skip-button {
    position: absolute;
    bottom: 30px;
    right: 30px;
    width: 250px;
    height: 60px;
    font-size: 28px;
    color: rgb(80, 75, 70);
    background-color: rgba(0, 0, 0, 0.3);
    border-width: 3px;
    border-color: rgb(150, 145, 140);
    border-radius: 10px;
    -unity-text-align: middle-center;
    letter-spacing: 2px;
}

.credits-skip-button:hover {
    background-color: rgb(232, 214, 107);
    border-color: rgb(255, 240, 150);
    color: rgb(30, 30, 30);
    scale: 1.05;
}

.credits-skip-button:active {
    background-color: rgb(40, 70, 80);
    scale: 0.95;
}
