.error-overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgb(0, 0, 0);
    align-items: center;
    justify-content: center;
    color: rgb(0, 0, 0);
}

.error-panel {
    width: 800px;
    padding: 50px;
    background-color: rgba(0, 0, 0, 0);
    border-radius: 20px;
    border-width: 5px;
    border-color: rgb(200, 60, 60);
    align-items: center;
    padding-top: 50px;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
}

.icon-container {
    width: 100%;
    height: 150px;
    align-items: center;
    justify-content: center;
    margin-bottom: 20px;
}

.error-icon {
    width: 120px;
    height: 120px;
    background-color: rgb(200, 60, 60);
    border-radius: 60px;
    border-width: 4px;
    border-color: rgb(255, 100, 100);
}

.error-title {
    font-size: 80px;
    color: rgb(174, 56, 56);
    -unity-font-style: bold;
    margin-bottom: 30px;
    -unity-text-align: middle-center;
    -unity-font-definition: url("project://database/Assets/_Project/Fonts/BoldPixels.ttf?fileID=12800000&guid=89ae0ccf11ce0314bb60394e36bc1305&type=3#BoldPixels");
}

.error-message {
    font-size: 45px;
    color: rgb(0, 0, 0);
    margin-bottom: 40px;
    -unity-text-align: middle-center;
    white-space: normal;
    max-width: 90%;
    -unity-font-definition: url("project://database/Assets/_Project/Fonts/BoldPixels.ttf?fileID=12800000&guid=89ae0ccf11ce0314bb60394e36bc1305&type=3#BoldPixels");
    line-height: 50px;
}

.button-container {
    width: 100%;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    margin-top: 20px;
}

.error-button {
    width: 300px;
    height: 80px;
    font-size: 45px;
    color: rgb(255, 255, 255);
    border-width: 3px;
    border-radius: 10px;
    margin-left: 15px;
    margin-right: 15px;
    -unity-text-align: middle-center;
    -unity-font-definition: url("project://database/Assets/_Project/Fonts/BoldPixels.ttf?fileID=12800000&guid=89ae0ccf11ce0314bb60394e36bc1305&type=3#BoldPixels");
}

.error-button.primary {
    background-color: rgb(35, 75, 90);
    border-color: rgb(127, 179, 192);
}

.error-button.primary:hover {
    background-color: rgb(232, 214, 107);
    border-color: rgb(255, 240, 150);
    color: rgb(30, 30, 30);
    scale: 1.05;
}

.error-button.primary:active {
    background-color: rgb(40, 70, 80);
    scale: 0.95;
}

.error-button.secondary {
    background-color: rgb(90, 60, 60);
    border-color: rgb(200, 100, 100);
}

.error-button.secondary:hover {
    background-color: rgb(200, 80, 80);
    border-color: rgb(255, 120, 120);
    color: rgb(255, 255, 255);
    scale: 1.05;
}

.error-button.secondary:active {
    background-color: rgb(70, 50, 50);
    scale: 0.95;
}
