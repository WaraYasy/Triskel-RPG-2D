<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Triskel_Proyect/UI/Menus/MainMenu.uss?fileID=7433441132597879392&amp;guid=5e9d0672d689db7448b9509a2df5de84&amp;type=3#MainMenu" />
    <ui:VisualElement name="MainMenuOverlay" class="main-menu-overlay" style="background-image: url(&quot;project://database/Assets/Triskel_Proyect/Sprites/UI/Common/Backgrounds/bg_main_menu.png?fileID=2800000&amp;guid=5c782f566e36c0b419cd306bdb0dafe1&amp;type=3#bg_main_menu&quot;); -unity-background-scale-mode: scale-and-crop; background-color: rgb(0, 0, 0);">
        <ui:VisualElement name="MainMenuPanel" class="main-menu-panel" style="background-image: none; justify-content: flex-end;">
            <ui:Label name="WelcomeLabel" class="main-menu-welcome" style="display: none; margin-bottom: 10px;" />
            <ui:VisualElement name="LoadingIndicator" style="display: none; align-items: center; justify-content: center; margin-bottom: 20px;">
                <ui:Label name="LoadingLabel" text="Cargando..." style="font-size: 55px; -unity-text-align: middle-center; color: rgb(0, 60, 107); -unity-font-definition: url(&quot;project://database/Assets/Triskel_Proyect/Fonts/BoldPixels.ttf?fileID=12800000&amp;guid=89ae0ccf11ce0314bb60394e36bc1305&amp;type=3#BoldPixels&quot;); -unity-font-style: normal;" />
            </ui:VisualElement>
            <ui:VisualElement name="ButtonContainer" class="button-container" style="height: 204px; width: 355px;">
                <ui:Button text="Iniciar Sesión" name="LoginButton" class="main-menu-button" />
                <ui:Button text="Salir" name="ExitButton" class="main-menu-button-secondary" />
                <ui:Button text="Continuar" name="ContinueButton" class="main-menu-button" style="display: none;" />
                <ui:Button text="Nueva Partida" name="NewGameButton" class="main-menu-button" style="display: none;" />
                <ui:Button text="Cerrar Sesion" name="LogoutButton" class="main-menu-button-secondary" style="display: none;" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
