    <ui:VisualElement name="CreditsOverlay" class="credits-overlay" style="background-image: url(&quot;project://database/Assets/_Project/Sprites/UI/Common/Backgrounds/bg_main_menu.png?fileID=2800000&amp;guid=5c782f566e36c0b419cd306bdb0dafe1&amp;type=3#bg_main_menu&quot;); -unity-background-scale-mode: scale-and-crop; background-color: rgb(0, 0, 0);">
