.inventory-slot.yellow {
    background-image: url("project://database/Assets/_Project/Sprites/UI/Elements/Inventary/Colored/yellow.png?fileID=21300000&guid=c60dd7faf10a7154f86ba07a856c0cdf&type=3#yellow");
}

.inventory-slot.yellow.selected {
